# Supabase — copy this file to .env.local and fill in your project's values.
# Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# NEVER put the service_role key in this file. Anything prefixed with VITE_ is
# bundled into the browser JavaScript and is readable by every visitor.
